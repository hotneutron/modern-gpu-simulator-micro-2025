-gpgpu_ptx_instruction_classification 0
-gpgpu_ptx_sim_mode 0
-gpgpu_ptx_force_max_capability 90

# Device Limits
-gpgpu_stack_size_limit 1024
-gpgpu_heap_size_limit 8388608
-gpgpu_runtime_sync_depth_limit 2
-gpgpu_runtime_pending_launch_count_limit 2048
-gpgpu_kernel_launch_latency 1500
-gpgpu_TB_launch_latency 0
-gpgpu_max_concurrent_kernel 128

# Compute Capability
-gpgpu_compute_capability_major 9
-gpgpu_compute_capability_minor 0

# PTX execution-driven
-gpgpu_ptx_convert_to_ptxplus 0
-gpgpu_ptx_save_converted_ptxplus 0

# high level architecture configuration
-gpgpu_n_clusters 132
-gpgpu_n_cores_per_cluster 1
-gpgpu_n_mem 40
-gpgpu_n_sub_partition_per_mchannel 2

# clock domains
#-gpgpu_clock_domains <Core Clock>:<Interconnect Clock>:<L2 Clock>:<DRAM Clock>
-gpgpu_clock_domains 1800:1800:1800:8000

# shader core pipeline config
-gpgpu_shader_registers 65536
-gpgpu_registers_per_block 65536
-gpgpu_occupancy_sm_number 90

# This implies a maximum of 48 warps/SM
-gpgpu_shader_core_pipeline 2048:32
-gpgpu_shader_cta 32
-gpgpu_simd_model 1

# Pipeline widths and number of FUs
# ID_OC_SP,ID_OC_DP,ID_OC_INT,ID_OC_SFU,ID_OC_MEM,OC_EX_SP,OC_EX_DP,OC_EX_INT,OC_EX_SFU,OC_EX_MEM,EX_WB,ID_OC_TENSOR_CORE,OC_EX_TENSOR_CORE
-gpgpu_pipeline_widths 4,4,4,4,4,4,4,4,4,4,8,4,4
-gpgpu_num_sp_units 4
-gpgpu_num_sfu_units 4
-gpgpu_num_int_units 4
-gpgpu_tensor_core_avail 1
-gpgpu_num_tensor_core_units 4

# Instruction latencies and initiation intervals
# "ADD,MAX,MUL,MAD,DIV"
# All Div operations are executed on SFU unit
-ptx_opcode_latency_int 4,4,4,4,21
-ptx_opcode_initiation_int 2,2,2,2,2
-ptx_opcode_latency_fp 4,4,4,4,39
-ptx_opcode_initiation_fp 2,2,2,2,2
-ptx_opcode_latency_dp 64,64,64,64,330
-ptx_opcode_initiation_dp 64,64,64,64,130
-ptx_opcode_latency_sfu 21
-ptx_opcode_initiation_sfu 8
-ptx_opcode_latency_tesnor 64
-ptx_opcode_initiation_tensor 64

# sub core model: in which each scheduler has its own register file and EUs
# i.e. schedulers are isolated
-gpgpu_sub_core_model 1
# disable specialized operand collectors and use generic operand collectors instead
-gpgpu_enable_specialized_operand_collector 0
-gpgpu_operand_collector_num_units_gen 8
-gpgpu_operand_collector_num_in_ports_gen 8
-gpgpu_operand_collector_num_out_ports_gen 8
# register banks
-gpgpu_num_reg_banks 8
-gpgpu_reg_file_port_throughput 2

# warp scheduling
-gpgpu_num_sched_per_core 4
-gpgpu_scheduler gto
# a warp scheduler issue mode
-gpgpu_max_insn_issue_per_warp 1
-gpgpu_dual_issue_diff_exec_units 1

## L1/shared memory configuration
# <nsets>:<bsize>:<assoc>,<rep>:<wr>:<alloc>:<wr_alloc>:<set_index_fn>,<mshr>:<N>:<merge>,<mq>:**<fifo_entry>
# ** Optional parameter - Required when mshr_type==Texture Fifo
# In adaptive cache, we adaptively assign the remaining shared memory to L1 cache
# For more info, see https://docs.nvidia.com/cuda/cuda-c-programming-guide/index.html#shared-memory-7-x
-gpgpu_adaptive_cache_config 1
-gpgpu_shmem_option 0,8,16,32,64,100,132,164,196,228
-gpgpu_unified_l1d_size 256
# L1 cache configuration
-gpgpu_l1_banks 4
-gpgpu_cache:dl1 S:4:128:512,L:T:m:L:L,A:384:48,32:0,32
-gpgpu_l1_banks_hashing_function 0

-gpgpu_gmem_skip_L1D 0
-gpgpu_flush_l1_cache 1
-gpgpu_flush_l2_cache 1
-gpgpu_n_cluster_ejection_buffer_size 32
-gpgpu_l1_cache_write_ratio 0

# shared memory  configuration
-gpgpu_shmem_size 233472
-gpgpu_shmem_sizeDefault 233472
-gpgpu_shmem_per_block 233472

# shared memory bankconflict detection
-gpgpu_shmem_num_banks 32
-gpgpu_shmem_limited_broadcast 0
-gpgpu_shmem_warp_parts 1
-gpgpu_coalesce_arch 90

# L2 cache
# Opt6 L2 data-port width (last field). The 32B->64B K10 A/B (section 4.11.1) was
# REJECTED: cycles moved +0.2% (262,744->263,273) because L2 is a 32B-sector cache
# (atom_sz=32), so ceil(32/64)==ceil(32/32)==1 leaves fill/HIT occupancy unchanged;
# width only touched 128B writeback occupancy (port_busy 660->314) which is not on
# the critical path. Reverted to 32. See TMA_LATENCY_INJECTION_H100.md section 4.11.1.
-gpgpu_cache:dl2 S:256:128:20,L:B:m:L:P,A:192:96,32:0,32
-gpgpu_cache:dl2_texture_only 0
# Fields = icnt->L2 : L2->dram : dram->L2 : L2->icnt(reply). The 4th field is the
# m_L2_icnt_queue (L2->core reply) depth. Opt6 Part-0 A/B (4 fwd runs) showed the
# reply path is NOT the cycle lever: depth 64->256 halved L2_TMA_output_full but
# cycles were flat; see TMA_LATENCY_INJECTION_H100.md section 4.5. Reverted to
# baseline 64:64:64:64.
-gpgpu_dram_partition_queues 64:64:64:64
# Opt6 Part-0 exp 1 knob: reply mf drained per sub-partition per ICNT tick from
# m_L2_icnt_queue into the REPLY icnt. The section 4.5 A/B (raise to 4 ALONE) only pushed
# the stall downstream (gpu_stall_icnt2sh 259K->722K) with flat cycles, because the reply
# path is TWO 1/tick chokes in series: [12]->[13] here, then [13]->[14] the per-SM cluster
# eject (gpgpu_cluster_reply_eject_per_cycle). Widening only one relocates onto the other.
# Opt6 4.11.6 pairs BOTH at 4 (= HW load-return ~4 sector/clk) so the whole reply path is
# opened at once, mirroring how grant_passes+icnt_to_l2_pop had to be paired on the inject
# side. Each mf still passes icnt_has_buffer/icnt_push, so byte accounting is unchanged.
-gpgpu_l2_reply_drain_per_cycle 4
-gpgpu_perf_sim_memcpy 1
-gpgpu_memory_partition_indexing 2
# Opt8/Opt9: 40 channels x2 = 80 L2 slices, but 40 is non-2^n so the IPoly path
# hashes into 128 then folds with `% 80`, double-counting slices 0..47 (pigeonhole)
# => up to 2:1 spatial load imbalance (a pure sim artifact; HW L2 slices are even
# to <=5% per lts__cycles_active). 1 = balanced avalanche hash removes the fold
# bias (uniform for all 2^n strides, deterministic, work-invariant). 0 = original
# ipoly%N. See L2_SLICE_PARALLELISM_H100.md 8.4.
-gpgpu_l2_slice_balanced_hash 1

# 128 KB Inst.
-gpgpu_cache:il1 N:64:128:16,L:R:f:N:L,S:32:32,32
-gpgpu_inst_fetch_throughput 4
# 128 KB Tex
# Note, TEX is deprected since Volta, It is used for legacy apps only. Use L1D cache instead with .nc modifier or __ldg mehtod
-gpgpu_tex_cache:l1 N:4:128:256,L:R:m:N:L,T:512:8,128:2
# 64 KB Const
-gpgpu_const_cache:l1 N:4:64:8,L:R:f:N:L,S:32:32,32
-gpgpu_perfect_inst_const_cache 0

# interconnection
# use built-in local xbar
-network_mode 2
-icnt_in_buffer_limit 512
-icnt_out_buffer_limit 512
-icnt_subnets 2
-icnt_flit_size 40
-icnt_arbiter_algo 1
# Local-xbar arbiter grant passes per cycle. The single shared REQ-net in_buffer per SM
# drains <=1 packet/input/cycle by default, which serializes TMA's 768x32B sector bursts
# (measured REQ in_buffer_full 355/cyc vs REPLY 6.3, avg_icnt_full 99.9% of TMA issue).
# 4 lets one SM eject 4 sectors/cycle (=one 128B line), relieving the injection bottleneck.
-icnt_grant_passes_per_cycle 4
# Paired downstream drain: pop up to 4 request mfs from the icnt xbar out_buffer into
# each L2 sub-partition per L2 tick. Without this, the faster icnt injection drain above
# would just back up in the xbar out_buffer (icnt->L2 pop was 1/sub-part/cycle). 4 matches
# the 4x32B sector line. Each pop still respects sub_partition full(SECTOR_CHUNCK_SIZE).
-gpgpu_icnt_to_l2_pop_per_cycle 4
# Opt6 4.11.4: TMA mover injection rate = 128B AGU lines / cycle into the shared SM->L2
# port (each line = 4x 32B sector mfs). HW per-SM injection bandwidth is 124 byte/clk =
# 4 sector/clk = 1 line/clk (arXiv:2501.12084 Table 5), so 1 is HW-calibrated. The old
# hardcoded value was 2 (=8 sector/clk = 2x HW per-SM BW), which over-injected and
# inflated Req_Network_in_buffer_full. Set to 1 to match measured HW injection bandwidth.
-gpgpu_tma_max_lines_per_cycle 1
# Opt6 4.11.6: ejection-side mirror of the two injection knobs above. Each SM (cluster)
# ejected only 1 reply mf/ICNT-tick from the REPLY icnt into the core (both handoffs in
# simt_core_cluster::icnt_cycle), a per-SM 1/tick reply choke. Measured: FWD ICNT_TO_SHADER
# = 332cyc (58% of round-trip), BWD reply_drain (section 4.5) was null because it only
# relocated the stall onto THIS eject. 4 = HW load-return BW (124 byte/clk = ~4 sector/clk),
# the same per-SM quantum as grant_passes/icnt_to_l2_pop. Pure timing calibration: each mf
# still passes its buffer-full gate, mf count / bytes unchanged (4.12 work axis).
-gpgpu_cluster_reply_eject_per_cycle 4
# Opt8: L2 admissions per sub-partition (=L2 slice) per L2 tick. Base sim admits 1
# sector (32B)/cycle/slice via cache_cycle's single top()/access()/pop(); real H100 L2
# slice throughput is 64B/cycle = 2x32B sectors (100-class HBM doubled per-slice width
# from V100's 32B; Cornell CVW GPU-memory + NVIDIA dev-forum L2-throughput thread). So
# the sim under-models L2 admission 2x, which serializes the 768-sector TMA burst into
# ROP_DELAY (90% of TMA round-trip, avg 1483cyc; DRAM 97% idle). 2 = HW-calibrated. The
# data port is modeled 2x32B-wide (extra replenish), each probe still runs the real
# access()+MSHR, so L2 hit-rate/DRAM work is invariant (timing-only). See
# L2_SLICE_PARALLELISM_H100.md. Default 1 = original behavior.
-gpgpu_l2_admit_sectors_per_cycle 2
# Opt9 Gate A: ROP delay-queue drain. Base sim moves only 1 sector/sub-partition/
# L2-tick from the ROP queue into m_icnt_L2_queue (a single if), which serialized the
# TMA burst into ROP_DELAY (bwd avg 558 after Opt8, 80% of the TMA round-trip) even
# though L2 admission is now 2-wide — the 2-wide bank was starved by this 1/tick feed.
# 2 = HW 64B/cycle/slice. Fixed rop_latency(100) unchanged; only drain rate widens
# (timing-only, work invariant). See TMA_LATENCY_INJECTION_H100.md 4.11.8. Default 1.
-gpgpu_l2_rop_drain_per_cycle 2
# Opt9 Gate B: DRAM->L2 reply drain (m_dram_L2_queue -> L2 fill | L2->icnt). Base sim
# moves only 1 returned line/sub-partition/L2-tick (a single if) — the reply-side
# mirror of Gate A. 2 = HW 64B/cycle/slice. The fill port is modeled 2-wide (extra
# fill-port replenish) so it does not saturate. Separate knob from Gate A (different
# code site/direction). timing-only, work invariant. Default 1.
-gpgpu_l2_dram_reply_drain_per_cycle 2

# memory partition latency config
# NOTE: rop_latency is added to EVERY non-texture (global/TMA) request before the
# L2 lookup (l2cache.cc:814), so even L2 hits pay it. With sim L2-hit=98.7% this
# one-way 211 cyc was the dominant inflation of the HW long_scoreboard axis (20.2%).
# Lowered 211 -> 100 to bring the global/TMA round-trip closer to the measured
# Hopper L2-hit latency and cut the ~2.86x cycle over-estimation on FA3 bwd k10.
-gpgpu_l2_rop_latency 100
-dram_latency 243

# dram sched config
-gpgpu_dram_scheduler 1
-gpgpu_frfcfs_dram_sched_queue_size 224
-gpgpu_dram_return_queue_size 224

# dram model config
-gpgpu_n_mem_per_ctrlr 1
-gpgpu_dram_buswidth 2
-gpgpu_dram_burst_length 16
-dram_data_command_freq_ratio 4
-gpgpu_mem_address_mask 1
-gpgpu_mem_addr_mapping dramid@8;00000000.00000000.00000000.00000000.0000RRRR.RRRRRRRR.RBBBCCCC.BCCSSSSS

# Mem timing
-gpgpu_dram_timing_opt nbk=16:CCD=4:RRD=12:RCD=24:RAS=55:RP=24:RC=78:CL=24:WL=8:CDLR=10:WR=24:nbkgrp=4:CCDL=6:RTPL=4
-dram_dual_bus_interface 0

# select lower bits for bnkgrp to increase bnkgrp parallelism
-dram_bnk_indexing_policy 0
-dram_bnkgrp_indexing_policy 1

#-dram_seperate_write_queue_enable 1
#-dram_write_queue_size 64:56:32

# stat collection
-gpgpu_memlatency_stat 14
-gpgpu_runtime_stat 500
-enable_ptx_file_line_stats 1
-visualizer_enabled 0

# Simulator wall-clock section timing (SIMULATOR-SPEED profiling, not sim accuracy).
# When 1, gpgpu_sim::cycle() accumulates host wall-clock per clock-domain section
# (CORE/DRAM parallel vs icnt_load/icnt_reply/L2/booksim serial) and prints a
# [SECTTIME-WINDOW] line every gpu_stat_sample_freq cycles (= the first field of
# -gpgpu_runtime_stat above, here 500) plus a [SECTTIME-TOTAL] line at kernel end.
# Timing-neutral: does NOT change any reported sim_cycle. Keep at 0 for normal runs;
# set to 1 only when profiling why a run is slow. See .plan/SIM_PERF_OPT.md.
-gpgpu_section_timing_enable 0

# tracing functionality
# Full component set enabled. Estimated log size for THIS run (OnlyKernel10, single
# kernel) is only ~3 GB, well within free space, because:
#   - WARP_SCHEDULER/SCOREBOARD/LIVENESS are gated by -trace_sampling_core (= core 0 only)
#   - MEMORY_PARTITION/SUBPARTITION are gated by -trace_sampling_memory_partition
#     (-1 = all partitions; set to a single id to shrink ~1/num_partitions if needed)
#   - INTERCONNECT has NO sampling gate (logs every push on all nodes) but the kernel's
#     total L2 sectors (~10.1M, NCU-measured) bound it to <1 GB
# The warp-issue stall distribution and the [LATCFG] dump are emitted by stat counters
# at kernel end regardless of trace_components.
# Components (src/trace_streams.tup): WARP_SCHEDULER, SCOREBOARD,
#   MEMORY_PARTITION_UNIT, MEMORY_SUBPARTITION_UNIT, INTERCONNECT, LIVENESS, TMA
-trace_enabled 0
-trace_components WARP_SCHEDULER,SCOREBOARD,MEMORY_PARTITION_UNIT,MEMORY_SUBPARTITION_UNIT,LIVENESS,TMA
-trace_sampling_core 0

# MOD. Begin. Added L0I.
-is_L0I_enabled 1
-max_request_allowed_to_L1I 1
-max_reply_allowed_from_L1I 1
-latency_L0_to_L1 2
-latency_L1_to_L0 2
-gpgpu_cache:il0 N:8:128:32,L:R:f:N:L,S:32:16,8
-gpgpu_subcore_const_cache:l0 N:4:64:2,L:R:f:N:L,S:32:32,32
# MOD. End

# MOD. Begin. Remodeling
-is_fetch_and_decode_improved 1
-is_extra_traces_enabled 1
-is_SM_remodeling_enabled 1
-num_subcores_in_SM 4
-is_remodeling_scoreboarding_enabled 0
-is_ibuffer_remodeled_enabled 1
-ibuffer_remodeled_size 5
-fetch_decode_width 1

-tensor_latency 32
-tensor_rate_per_cycle 32768
-branch_latency 2
-half_latency 3
-uniform_latency 2
-predicate_latency 13
-miscellaneous_queue_latency 2
# [NANOSLEEP spin lever] This value ALSO sizes the MISC_NO_QUEUE functional-unit pipeline depth
# (functional_unit m_pipeline_depth = max_latency, set at FU construction in subcore.cc). A fixed-
# latency inst is placed at pipe stage (latency-1), asserted < m_pipeline_depth, so if NANOSLEEP is
# given a dedicated latency > 1 (-trace_opcode_latency_initiation_nanosleep), THIS depth must be
# raised to >= that latency or the FU asserts. Restored to 1 (NANOSLEEP experiment closed as a
# non-lever, 2026-07-20 — see .plan/FWD_DRAIN_IDLE_MBARRIER_CEILING.md / FA3_progress.md).
-miscellaneous_no_queue_latency 1

-branch_initiation 1
-half_initiation 2
-uniform_initiation 2
-predicate_initiation 2
-miscellaneous_queue_initiation 2
-miscellaneous_no_queue_initiation 1

# [NANOSLEEP spin lever] trace-mode per-op latency,initiation for MISCELLANEOUS_NO_QUEUE ops.
# NANOSLEEP.SYNCS (the producer mbarrier backoff-sleep in FA3's warp-specialized pipeline) decodes to
# MISCELLANEOUS_NO_QUEUE_OP. It now has a DEDICATED knob below (-..._nanosleep), split out in code, so
# this shared MISC_NO_QUEUE knob stays at its baseline and is NOT the experiment lever anymore.
-trace_opcode_latency_initiation_miscellaneous_no_queue 1,1

# [NANOSLEEP spin lever] DEDICATED NANOSLEEP latency,initiation (split from MISC_NO_QUEUE in code so it
# perturbs ONLY nanosleep). Restored to baseline "1,1" — the 64,1 experiment (2026-07-20) showed
# widening the producer's mbarrier-spin backoff does NOT recover the drain-idle: cycles rose slightly
# (fwd 135,999->137,207 +0.9%, bwd 215,895->217,423 +0.7%) and eligible-warp stayed flat (0.53/0.41),
# because at 1 CTA/SM ~20% occupancy the freed issue slots have no other warp to fill. Closed as a
# non-lever. To re-run, set this >1 AND raise -miscellaneous_no_queue_latency to >= it (FU depth).
# See .plan/FWD_DRAIN_IDLE_MBARRIER_CEILING.md.
-trace_opcode_latency_initiation_nanosleep 1,1

-miscellaneous_queue_size 3
-memory_subcore_queue_size 4
-memory_intermidiate_stages_subcore_unit 6
-memory_sm_prt_size 128
-sm_memory_unit_l1c_access_queue_size 1
-sm_memory_unit_l1t_access_queue_size 1
-sm_memory_unit_l1d_access_queue_size 1
-sm_memory_unit_shmem_access_queue_size 1
-sm_memory_unit_bypass_l1d_directly_go_to_l2_access_queue_size 1
-sm_memory_unit_miscellaneous_access_queue_size 1
-num_cycles_to_wait_to_dispatch_another_inst_from_subcore_to_sm_shared_pipeline_when_is_mem_inst 2
-num_cycles_to_wait_to_dispatch_another_inst_from_subcore_to_sm_shared_pipeline_when_is_dp_inst 1

-memory_maximum_coalescing_cycles 1
-offset_latency_firts_stage_memory_subcore 0
-memory_shared_memory_minimum_latency 7
-memory_shared_memory_extra_latency_ldsm_multiple_matrix 2
-memory_shared_memory_extra_latency_stsm_multiple_matrix 2
-memmory_max_concurrent_requests_shmem_per_sm 999999
-memmory_max_concurrent_requests_standard_per_sm 1024
-memory_l1d_minimum_latency 13
-memory_global_shared_latency_for_ldgsts 19
-memory_l1d_max_lookups_per_cycle_per_bank 4
-memory_subcore_extra_latency_load_shared_mem 2
-constant_cache_latency_at_sm_structure 11

-memory_num_scalar_units_per_subcore 8
-memory_subcore_link_to_sm_byte_size 128
-is_load_half_bandwidth_in_the_subcore_link_to_sm_enabled 1
-is_store_half_bandwidth_in_the_subcore_link_to_sm_enabled 1

-dp_sm_shared_queue_size 1
-dp_subcore_queue_size 3
-dp_shared_intermidiate_stages 6
-dp_subcore_max_latency 13
-is_dp_pipeline_shared_for_subcores 1
-is_fp32ops_allowed_in_int_pipeline 1

-is_const_cache_accessed_blocks_tracking_enabled 1
-is_global_memory_accesses_blocks_tracking_enabled 1
-is_num_virtual_pages_tracking_enabled 1
-virtual_page_size_in_bytes 2097152
-num_const_cache_cycle_misses_before_switch_to_other_warp 4
-num_cycles_issue_port_busy_after_imadwide 1
-num_stall_cycles_wait_after_bits_stall_0_and_yield 46
-num_cycles_to_stall_SM_at_gpu_memory_barrier 186
-num_cycles_to_stall_SM_at_system_memory_barrier 2900
-num_cycles_to_stall_SM_at_cta_memory_barrier 53

#Subcore parameters
-perfect_constant_cache 0
-perfect_instruction_cache 0
-ibuffer_coalescing 0
-invalidate_instruction_caches_at_kernel_end 1
-is_instruction_prefetching_enabled 1
-prefetch_per_stream_buffer_size 4
-prefetch_num_stream_buffers 1
-num_instruction_prefetches_per_cycle 1
-is_instruction_region_prewarm_enabled 1
-instruction_region_prewarm_min_late_miss_count 8
-instruction_region_prewarm_min_observed_warps 4
-instruction_region_prewarm_max_regions 2
-instruction_region_prewarm_max_lines_per_cycle 2
# L1I prefetch eager-promote (Option B): promote a ready prefetched line into the
# L1I tag array as soon as it is filled in the stream buffer, without waiting for a
# demand and without producing an L0I response. Gated by L1I fill-port availability.
# See .plan/L1I_prefetch_redesign.md. Set to 1 to enable the experiment.
-is_instruction_prefetch_eager_promote_enabled 1
# L1I prefetch eager-promote debug logging ([L1IPFDBG]). Enable for early triage of
# 24h runs; budget caps per-SM event lines (watchdog/critical signals are budget-free).
-l1i_prefetch_debug_enable 0
-l1i_prefetch_debug_budget 2000000

# [WGMMA Opt6 Step-0] observe-only tensor/fu_occupied instrumentation (per-pipe fu_occupied
# split, tensor reissue-lockout, [WGMMADBG-MNK] shape log). No timing change.
# Set back to 0 for normal runs.
-wgmma_step0_instrument_enable 1
# [L1I frontend Step-0] observe-only frontend SM-idle instrumentation
# (sm_idle_blocked_by_frontend_sbwait). The full SM-idle reason decomposition
# (sm_idle_reason_*) is emitted when EITHER this or -wgmma_step0_instrument_enable is set.
# ENABLED for the frontend SM-idle decomposition measurement run; set back to 0 for normal runs.
-l1i_frontend_step0_instrument_enable 1
# [CTA stall breakdown] observe-only per-CTA-slot NON-tensor drain-idle counters appended to
# the [CTAFIN] line (sm_idle_cyc + sm_idle_ibuffer_empty_cyc). Correlates fwd CTA finish-cycle
# variance with non-tensor causes in the SAME run. No timing change. Needs -wgmma_step0_instrument_enable
# (prints [CTAFIN]). Set back to 0 for normal runs.
-cta_stall_breakdown_instrument_enable 1
# [FWD drain-idle 축3] observe-only mbarrier wait-duration histogram ([SYNCWAITHIST]). Independent
# gate (dedicated arrays, never the issue-path m_pending_sync_waits) so it stays timing-neutral and
# can be bisected against the other instrument flags on a bit-identity failure. Set back to 0 for normal runs.
-sync_wait_hist_instrument_enable 1
# [NANOSLEEP spin lever] observe-only counters that measure how often the producer's mbarrier
# spin-loop (PHASECHK/TRYWAIT/NANOSLEEP) wins an issue slot and displaces a co-eligible warp.
# Emits: total_num_cycles_spin_ops_issued / _spin_won_over_eligible / total_num_spin_phasechk_issued.
# Independent gate (pure read of per-cycle issue state), timing-neutral. Set back to 0 for normal runs.
# See .plan/FWD_DRAIN_IDLE_MBARRIER_CEILING.md.
-spin_instrument_enable 1
# [Head-of-line lever] observe-only re-scan on next_stage_not_available cycles (ISSUE_CONTROL latch
# full) to size the recoverable head-of-line blocking fraction. Emits: total_num_cycles_next_stage_
# scanned / _with_ready_warp / total_num_ready_warps_during_next_stage / _blocked_by_{tensor,mem,other}.
# Read-only, timing-neutral. Independent gate. Set back to 0 for normal runs. See CONSUMER_COMPUTE_BOUND.md.
-headofline_instrument_enable 1
# Hopper mbarrier sync debug logging (SYNCDBG) + TMA debug logging (TMADBG).
# Also gates the std::cerr bootstrap logs [TMA][Phase2] (sidecar load summary +
# per-site binding), [SYNC] loaded, and [SMDBG][barrier-issue].
# All share the print budget below. Set -sync_debug_enable 1 to emit these per-SM
# sync and TMA event logs to stderr.
# Disabled for this run: it emits from ALL SMs and overlaps with the core-0
# DTRACE(TMA) path, doubling/exploding the log. TMA events are already captured
# via -trace_components TMA on core 0.
-sync_debug_enable 0
-sync_debug_print_budget 40000000
-sync_debug_skip_runtime_budget 1024
# TMA-only debug logging (TMADBG), independent of -sync_debug_enable. Enables the
# TMA unit's per-event stderr logs (first-request / fill-retire / complete /
# icnt-backpressure / store/reduce issue). Set to 1 to enable; budget caps lines
# per SM to bound log size.
# ENABLED for the real-base verification run so [TMADBG] + the end-of-run
# [TMA][Phase2][Stats] real_base/synthetic coverage summary are captured.
-tma_debug_enable 0
-tma_debug_print_budget 20000000
# Use the exact per-site GMEM base (tma_pc_base_map.json) instead of the synthetic
# transfer_uid address, so L2 locality matches HW (fwd ~70% / bwd ~82%). On by default
# (M4). When on, the simulator FATAL-asserts if no base map is loaded (missing/empty
# tma_pc_base_map.json) instead of silently falling back to fake locality. For a trace
# with no TMA descriptors (non-FA3), set this to 0 explicitly. Kept explicit here for
# clarity / A-B.
-tma_real_base_addr_enable 1
# M2.5: give UBLKRED/UBLKCP (raw-pointer, non-tensormap ops) their real GMEM base
# (read offline from the by-value params struct in launch_param_blobs) + visit-counter
# mock tiling, instead of the synthetic (transfer_uid<<20) address. Requires
# -tma_real_base_addr_enable 1 (the base map must be loaded). Without this, UBLKRED/UBLKCP
# keep the synthetic scatter that pulls bwd L2 hit rate below HW. Enabled for the M2.5
# verification run so dQaccum reduction tiles revisit their real base (bwd toward ~82%).
-tma_operand_addr_tiling_enable 1
# BAR.SYNC / BAR.ARV named-barrier debug logging (BARDBG), independent of the above.
# Emits: [BARDBG][issue] per-issue decode (bar_type/id/count/wait_bits, capped by issue
# budget), [BARDBG][release] first occurrence per (bar_id,bar_type,count), and
# [BARDBG][summary]/[BARDBG][leak] at CTA teardown so participant-only leaks are visible
# even when no warp is still parked at the barrier.
# For the 24h FA3 verification run, keep issue budget high enough to preserve late-run
# decode context. 2,000,000 is a good default; reduce only if stderr volume becomes a
# problem.
-bar_debug_enable 0
-bar_debug_issue_budget 2000000
-is_rf_cache_enabled 1
-max_operands_regular_register_file 4
-max_latency_regular_register_file_latency 24
-num_regular_register_file_read_ports_per_bank 1
-num_regular_register_file_write_ports_per_bank 1
-max_size_register_file_write_queue_for_fixed_latency_instructions 8
-max_pops_per_cycle_register_file_write_queue_for_fixed_latency_instructions 1
-num_threads_granularity_read_regular_register_file_dp_inst 32
-num_threads_granularity_read_regular_register_file_mem_inst 32
-num_threads_granularity_read_regular_register_file_sfu_inst 32
-num_threads_granularity_read_regular_register_file_other_inst 32
-num_cycles_needed_to_write_a_reg_from_sm_struct_to_subcore 2
# MOD. End

# MOD. Begin. Fix WAR at baseline. scoreboard_reads for solving war hazards in the baseline configuration parameters
-scoreboard_war_mode opc
-scoreboard_war_max_uses_per_reg 9999
-scoreboard_war_static_power 0
-scoreboard_war_dynamic_power 0
# MOD. End

-is_custom_omp_scheduler_enabled 1
-custom_omp_scheduler_ratio_to_dynamic 0.3

-filter_first_kernel_id 0
-filter_last_kernel_id 500

-measure_coalescing_potential_stats 0
-number_of_coalescers 4
-prt_selection_policy_string OLDEST
-number_of_clusters_for_prt_selection 16
-interwarp_coalescing_quanta_warppool_policy_miss_ratio_threshold 0.99
-is_interwarp_coalescing_enabled 0
-num_interwarp_coalescing_tables 1
-interwarp_coalescing_quanta 100000
-interwarp_coalescing_selection_policy_string OLDEST
-max_size_interwarp_coalescing_per_table 99999
